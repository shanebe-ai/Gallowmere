# Copy to .env and fill in. Never commit .env.
PORT=3004
NODE_ENV=production

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gallowmere
DB_USER=gallowmere
DB_PASSWORD=change_me

# Free tier keys. Leave blank and the barkeep falls back to scripted lines.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Comma separated character names allowed to use admin commands (aistats).
ADMIN_NAMES=Shane

# Limits
AI_DAILY_CAP_PER_PLAYER=200
GROQ_RPM=25
GEMINI_RPM=12
