# Copy to .env and fill in. Never commit .env.
PORT=3004
NODE_ENV=production

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gallowmere
DB_USER=gallowmere
DB_PASSWORD=change_me

# Free tier keys. Leave blank and the barkeep falls back to scripted lines.
AIAND_API_KEY=
AIAND_MODEL=google/gemma-4-31b-it
AIAND_REASONING_EFFORT=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Player ids allowed to use admin commands (aistats). 1 is the first character ever created.
ADMIN_PLAYER_IDS=1

# Telnet door for MUD clients like Mudlet
TELNET_PORT=4004

# Limits
AI_DAILY_CAP_PER_PLAYER=200
GROQ_RPM=25
GEMINI_RPM=12
AI_DAILY_CAP_GLOBAL=5000
MAX_CONNECTIONS_PER_IP=8
